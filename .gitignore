# 依赖（本项目零依赖，出现 node_modules 说明误装了东西）
node_modules/

# 日志与临时产物
*.log
*.jsonl
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地调试图（截图一律放项目外，这里兜个底）
shot-*.png
_shots/

# WorkBuddy 助手工作区（记忆文件，不上传）
.workbuddy/
.wrangler/

# 解包临时目录（第三方 zip 解出来的中间产物，不入库）
_tmp-*-zip/

# 取证 / 调试截图（_tmp- 前缀一律不入库，与 _tmp-*-zip/ 同口径）
_tmp-*.png

# AI 生成图的落盘原图（挑定之后正式资产才进 art/；中间产物不入库）
generated-images/

# 历史调试产物归档（2026-10-25 整理，勿部署勿提交）
_archive-*/
