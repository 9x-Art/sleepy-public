# 依赖（本项目零依赖，出现 node_modules 说明误装了东西）
node_modules/

# 日志与临时产物
*.log
*.jsonl
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地调试图（截图一律放项目外，这里兜个底）
shot-*.png
_shots/

# 本地助手工作区（记忆文件，不提交）
.workbuddy/
.wrangler/

# 解包临时目录（第三方 zip 解出来的中间产物，不入库）
_tmp-*-zip/

# 取证 / 调试截图（_tmp- 前缀一律不入库，与 _tmp-*-zip/ 同口径）
_tmp-*.png

# AI 生成图的落盘原图（挑定之后正式资产才进 art/；中间产物不入库）
generated-images/

# 历史调试产物归档（2026-10-25 整理，勿部署勿提交）
_archive-*/
_tmp-deploy-conv/

# 临时探针/候选目录与文件一律不入库（2026-10-31 体检：_tmp-probe-* 等曾有缺口）
_tmp-*/
_tmp-*

# 工作过程产物只留本地、不上 GitHub（2026-10-31 清理：
# docs 交接/验收/方案 325 个、preview 预览稿、_retired 退役旧物，
# 里面带着本机路径，公开仓库不该有；磁盘上原样保留）
docs/
preview/
_retired/

# scripts 只留核心工具（smoke/check/deploy/gen-version/harness/pack-android/make-icons），
# 其余一次性测试/探针/交接打包脚本（browser-*、probe-*、offline-f2-*、make-*handover 等）
# 一律不入库 —— 新写的一次性脚本默认就不会跟到 GitHub 上
scripts/*
!scripts/smoke.js
!scripts/check.js
!scripts/deploy.sh
!scripts/gen-version.js
!scripts/harness.js
!scripts/pack-android.sh
!scripts/make-icons.js
# 行为迁移基线套件（2026-11-02 收口批入白名单）：耐久回归守卫，不是一次性脚本 ——
# 之前被 scripts/* 误伤，本地跑得欢但换机即失，还漂了一个月没人知道。
# browser-behavior-decision-test.js 仍按一次性口径留库外。
!scripts/behavior-text-test.js
!scripts/behavior-baseline-capture.js
!scripts/behavior-baseline-test.js
!scripts/behavior-baseline-write-test.js
!scripts/behavior-offline-migration-test.js
!scripts/behavior-online-migration-test.js
!scripts/fixtures/
!scripts/fixtures/behavior-baseline-v1.json
