+    if (!a1.ok) throw new Error('createRequest 失败：' + JSON.stringify(a1.error));
+    const r1 = S.action.runRequest(a1.request.id);
+    if (!r1.ok) throw new Error('runRequest 失败：' + JSON.stringify(r1.error));
+
+    const evId = r1.eventId;
