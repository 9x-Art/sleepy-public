+}
+function ta4Transport(responses) {
+  let i = 0;
+  let calls = 0;
+  return {
+    get calls() { return calls; },
+    fn() {
+      calls++;
+      const r = responses[Math.min(i, responses.length - 1)];
+      i++;
+      return Promise.resolve({ ok: true, text: JSON.stringify(r) });
+    }
+  };
+}
