+
+t('text 与 parts 拼接不一致 → join-mismatch，整体回退', function () {
+  var h = boot({});
+  var orig = h.S.behaviorText.forScenario;
+  h.S.behaviorText = Object.assign({}, h.S.behaviorText, {
+    forScenario: function (sc) {
+      var r = orig(sc);
+      if (sc !== 'offline') return r;
