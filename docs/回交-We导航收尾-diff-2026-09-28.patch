+  background:none;border:1px dashed rgba(176,138,94,.5);border-radius:0;
+  cursor:pointer;
+}
+.we-time-more:active{background:rgba(176,138,94,.08)}
+
+/* 时光 → 来源定位的短高亮（weNav.revealInPage，1.6s 后自动摘） */
