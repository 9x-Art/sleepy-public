+}
+.we-tab.is-on{color:var(--text)}
+.we-tab.is-on .we-tab-line{background:var(--g-accent-deep, var(--g-accent))}
+.we-tab-add{
+  flex:none;display:flex;align-items:center;justify-content:center;
+  width:44px;border:0;background:none;
+  color:var(--text-dim);cursor:pointer;
+}
+.we-tab-add svg{display:block}
+.we-tab-add:active{opacity:.65}
+
+/* ---- 时光页 ---- */
+.we-time-cover{height:200px}
+.we-time-day{
+  display:flex;align-items:baseline;gap:10px;
+  margin:24px 0 10px;padding-bottom:6px;
+  border-bottom:1px solid rgba(27,25,23,.14);
+}
